rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {userId}
    // Fields:
    //   - uid: string (required) - User's unique ID
    //   - balance: number (required) - Virtual trading balance
    //   - displayName: string (required) - User's name
    //   - photoURL: string (optional) - User's avatar
    //
    // Collection: trades
    // Document ID: {tradeId}
    // Fields:
    //   - id: string (required) - Unique trade ID
    //   - type: string (BUY|SELL) - Trade direction
    //   - entryPrice: number - Price at entry
    //   - exitPrice: number (optional) - Price at exit
    //   - amount: number - Trade amount
    //   - timestamp: number - Entry time
    //   - expiry: number - Expiry time
    //   - status: string (open|won|lost) - Trade status
    //   - asset: string - Asset name (e.g. BTC/USD)
    //   - uid: string - Owner's UID
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.uid;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (request.auth.token.email == "silas.hp84@gmail.com" && request.auth.token.email_verified == true));
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'balance', 'displayName', 'goalsReached']) &&
             data.uid is string &&
             data.balance is number &&
             data.displayName is string &&
             data.displayName.size() > 0 && data.displayName.size() < 100 &&
             data.goalsReached is number &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() < 500));
    }

    function isValidTrade(data) {
      return data.keys().hasAll(['id', 'type', 'entryPrice', 'amount', 'timestamp', 'expiry', 'status', 'asset', 'uid']) &&
             data.type in ['BUY', 'SELL'] &&
             data.status in ['open', 'won', 'lost'] &&
             data.amount is number && data.amount > 0 &&
             data.entryPrice is number &&
             data.asset is string &&
             data.uid == request.auth.uid;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidUser(request.resource.data) && (!('role' in request.resource.data) || isAdmin());
      allow update: if (isOwner(userId) && isValidUser(request.resource.data) && request.resource.data.role == resource.data.role) || isAdmin();
    }

    match /trades/{tradeId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if isAuthenticated() && isValidTrade(request.resource.data);
      allow update: if (isDocOwner() && isValidTrade(request.resource.data)) || isAdmin();
    }
  }
}
